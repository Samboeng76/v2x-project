{
  includeTimestamps: true,
  // Shared by MAP and SPaT when both are generated.

  intersection: {
    id: 42,
    name: "Sample Intersection"
  },

  // MAP geometry is generated from the initial four-way preset.
  // Replace the illustrative reference point with surveyed coordinates.
  map: {
    layout: "fourWayNoLeftTurn",
    refPoint: {
      latitude: 38.9564590,
      longitude: -77.1502970
    },
    laneWidthCm: 366,
    intersectionHalfExtentM: 10,
    approachExtentM: 30
  },

  spat: {
    // Omit this field to use the default 0.1-second interval.
    messageInterval: 0.1,

    movements: [
      {
        name: "Northbound Through",
        signalGroup: 1,
        phases: [
          { phase: "protected-Movement-Allowed", duration: 10 },
          { phase: "protected-clearance", duration: 5 }
        ]
      },
      {
        name: "Eastbound Through",
        signalGroup: 3,
        phases: [
          { phase: "stop-And-Remain", duration: 10 },
          { phase: "permissive-Movement-Allowed", duration: 5 }
        ]
      },
      {
        name: "Southbound Through",
        signalGroup: 2,
        phases: [
          { phase: "stop-And-Remain", duration: 10 },
          { phase: "protected-Movement-Allowed", duration: 5 }
        ]
      },
      {
        name: "Westbound Through",
        signalGroup: 4,
        phases: [
          { phase: "protected-Movement-Allowed", duration: 10 },
          { phase: "protected-clearance", duration: 5 }
        ]
      }
    ]
  }
}
